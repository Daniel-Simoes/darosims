{
  "name": "darosims",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "npm run dev --prefix backend",
    "dev:all": "concurrently -n backend,web -c blue,green \"npm run dev:backend\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "build:backend": "npm run build --prefix backend",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lottie-react": "^3.1.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/styled-components": "^5.1.36",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.6",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
