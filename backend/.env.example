# Local dev only — never commit real secrets (see SECURITY.md).
ADMIN_EMAIL=daniel@daros.com
ADMIN_PASSWORD=change-me-min-8-chars
JWT_SECRET=change-this-secret-in-production-use-openssl-rand

# Default demo accounts when seeding (hashed at bootstrap). Local dev only.
DEV_SEED_PASSWORD=1234

# Frontend origin for CORS + cookies (must match deployed SPA URL)
CORS_ORIGIN=http://localhost:5173

# Optional — detailed /api/health (omit in prod unless debugging)
# HEALTH_CHECK_KEY=

# Persistent DB on Vercel (Supabase)
# DATABASE_PROVIDER=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Never expose SUPABASE_SERVICE_ROLE_KEY or anon key in the frontend bundle.

# LGPD notifications
# LGPD_DPO_EMAIL=privacidade@daros.com